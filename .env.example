APP_NAME="Hospital Assessment API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dev_db
DB_USERNAME=root
DB_PASSWORD=password
QUEUE_CONNECTION=database
CACHE_STORE=array
SESSION_DRIVER=array
PAYMENT_FAILURE_SIMULATION=false

# for the seed heavy dataset like 500+ records for testing purpose, set this to true. Otherwise set it to false.
SEED_HEAVY_DATASET=true
