{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "assessment/hospital-api",
    "description": "Transactional Laravel and PostgreSQL hospital service ordering API",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
        "test": "@php artisan test",
        "analyse": "phpstan analyse --memory-limit=512M --no-progress",
        "lint": "find app bootstrap config database public routes scripts tests -name '*.php' -print0 | xargs -0 -n1 php -l && php -l artisan"
    },
    "config": {"optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist", "platform": {"php": "8.2.35"}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
